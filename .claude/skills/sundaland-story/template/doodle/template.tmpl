<!doctype html>
<html lang="en" data-resolution="landscape">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <script src="ink-theater.js"></script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      @font-face { font-family: "InkHand"; src: url("assets/patrickhand.ttf") format("truetype"); font-display: block; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #ffffff; }
      #root { position: relative; width: 1920px; height: 1080px; overflow: hidden; background: #ffffff; }
      #world { position: absolute; inset: 0; filter: url(#boilR); }
      .actor { position: absolute; }
      .pose, .idle { position: absolute; inset: 0; transform-origin: 50% 100%; }
      .idle img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
      .shadow { position: absolute; left: 18%; width: 64%; bottom: -12px; height: 24px; border-radius: 50%;
                background: radial-gradient(ellipse at center, rgba(0,0,0,0.13) 0%, rgba(0,0,0,0) 70%); opacity: 0; }
      .bubble { position: absolute; background: #fff; border: 6px solid #1a1a1a; border-radius: 46px; padding: 26px 40px;
                font-family: "InkHand", cursive; font-size: 58px; line-height: 1.08; color: #1a1a1a; opacity: 0; transform-origin: 80% 100%; }
      .bubble:after { content: ""; position: absolute; right: 90px; bottom: -44px; width: 0; height: 0;
                border-left: 26px solid transparent; border-right: 26px solid transparent; border-top: 44px solid #1a1a1a; }
      .bgimg { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; opacity: 0; visibility: hidden; }
      .label { position: absolute; font-family: "InkHand", cursive; font-size: 64px; color: #2a2a2a; opacity: 0; transform: translateX(-50%); }
    </style>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute">
      <filter id="boilR" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence id="boilTurb" type="fractalNoise" baseFrequency="0.018" numOctaves="1" seed="1" result="n"/>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6"/>
      </filter>
    </svg>
    <div id="root" data-composition-id="main" data-start="0" data-duration="__TOTAL__" data-width="1920" data-height="1080">
      <div id="world"></div>
    </div>
    <script>
      window.__timelines = window.__timelines || {};
      if (document.fonts && document.fonts.load) { document.fonts.load("80px InkHand"); }
      var tl = gsap.timeline({ paused: true });
      var E = InkTheater.ease, world = document.getElementById("world"), root = document.getElementById("root");
      var GROUND = 960, SIZE = __SIZE__, LIVE = [];
      function actor(name, cx, k, ground) {
        var g = ground || GROUND, w = SIZE[name][0] * k, h = SIZE[name][1] * k;
        var a = document.createElement("div"); a.className = "actor";
        a.style.cssText = "left:" + (cx - w / 2) + "px;top:" + (g - h) + "px;width:" + w + "px;height:" + h + "px";
        var sh = document.createElement("div"); sh.className = "shadow";
        var pose = document.createElement("div"); pose.className = "pose";
        var idle = document.createElement("div"); idle.className = "idle";
        var img = document.createElement("img"); img.src = "assets/poses/" + name + ".png"; img.alt = name;
        idle.appendChild(img); pose.appendChild(idle); a.appendChild(sh); a.appendChild(pose); world.appendChild(a);
        gsap.set(pose, { scale: 0, opacity: 0 });
        var A = { el: a, pose: pose, idle: idle, shadow: sh }; LIVE.push(A); return A;
      }
      function popIn(A, t) {
        tl.fromTo(A.pose, { scale: 0, opacity: 1 }, { scale: 1, opacity: 1, duration: 0.42, ease: E.overshoot, immediateRender: false }, t);
        tl.fromTo(A.shadow, { opacity: 0 }, { opacity: 1, duration: 0.3, immediateRender: false }, t + 0.1);
      }
      function popOut(A, t) {
        tl.fromTo(A.pose, { scale: 1 }, { scale: 0, duration: 0.16, ease: "power2.in", immediateRender: false }, t);
        tl.set(A.pose, { opacity: 0 }, t + 0.16); tl.to(A.shadow, { opacity: 0, duration: 0.12 }, t);
      }
      function swap(A, B, t) { popOut(A, t); popIn(B, t + 0.1); }
      function breathe(A, t0, t1) {
        var n = Math.max(1, Math.floor((t1 - t0) / 0.9));
        tl.fromTo(A.idle, { scaleY: 1, scaleX: 1 }, { scaleY: 1.025, scaleX: 0.99, duration: 0.45, ease: "sine.inOut", yoyo: true, repeat: n * 2 - 1, immediateRender: false }, t0);
      }
      function hops(A, t0, d, step, dy) {
        tl.fromTo(A.idle, { y: 0 }, { y: dy, duration: step, ease: "power1.out", yoyo: true, repeat: Math.max(1, Math.floor(d / step) - 1), immediateRender: false }, t0);
      }
      function jitter(A, t0) {
        tl.fromTo(A.idle, { x: 0 }, { x: 6, duration: 0.05, ease: "none", yoyo: true, repeat: 7, immediateRender: false }, t0);
      }
      function shake(t0) {
        tl.fromTo(world, { x: 0 }, { x: 12, duration: 0.04, ease: "none", yoyo: true, repeat: 7, immediateRender: false }, t0);
        tl.set(world, { x: 0 }, t0 + 0.35);
      }
      function bubble(text, x, y, t0, maxw) {
        var b = document.createElement("div"); b.className = "bubble"; b.textContent = text;
        b.style.cssText += "left:" + x + "px;top:" + y + "px;max-width:" + maxw + "px"; root.appendChild(b);
        tl.fromTo(b, { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.3, ease: E.overshoot, immediateRender: false }, t0);
        LIVE.push({ el: b, bubble: true });
      }
      function label(text, x, y, t0) {
        var l = document.createElement("div"); l.className = "label"; l.textContent = text;
        l.style.cssText += "left:" + x + "px;top:" + y + "px"; root.appendChild(l);
        tl.fromTo(l, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.3, ease: "power2.out", immediateRender: false }, t0);
        LIVE.push({ el: l, bubble: true });
      }
      function bg(name, t) {
        var im = document.createElement("img"); im.className = "bgimg"; im.src = "assets/bg/" + name + ".jpg"; world.appendChild(im);
        tl.set(im, { autoAlpha: 1 }, t); LIVE.push({ el: im, bubble: true });
      }
      function hideAll(t) {   // end of an insert: everything created so far disappears (hard cut to white gap)
        LIVE.forEach(function (A) { tl.set(A.bubble ? A.el : A.el, { autoAlpha: 0 }, t); }); LIVE = [];
      }
__BLOCKS__
      InkTheater.boil(document.getElementById("boilTurb"), tl, { duration: __TOTAL__, fps: 8 });
      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
